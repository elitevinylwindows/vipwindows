APP_NAME="VIP Windows"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://vipwindowsinc.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── SHARED DATABASE (same as Enterprise ERP) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enterprise_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ── ZOHO MAIL SMTP ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=info@vipwindowsinc.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@vipwindowsinc.com
MAIL_FROM_NAME="VIP Windows"
