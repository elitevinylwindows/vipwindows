APP_NAME="VIP Windows"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://vipwindows.net

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── SHARED DATABASE (same as Enterprise ERP) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enterprise_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
